root = true

[*]
indent_style = space
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

[*.{cs,csx}]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning

# High-value performance rule that would require LoggerMessage source-gen delegates
# throughout. Deferred deliberately for the MVP; revisit when hot-path logging matters.
dotnet_diagnostic.CA1848.severity = none
# CA1515: internal-by-default for app types — Program is intentionally public for WebApplicationFactory.
dotnet_diagnostic.CA1515.severity = none

[*.{json,js,yml,yaml,csproj,props,targets,html,razor,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Test method names use underscores by convention.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
