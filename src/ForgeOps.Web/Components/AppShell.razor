@inject NavigationManager Nav

<div class="shell">
    <div class="shell__brand">
        <div class="brand__mark">F</div>
        <div class="brand__name">ForgeOps <span>Control Plane</span></div>
    </div>

    <header class="shell__topbar">
        <div class="topbar__context">
            <span>Record</span>
            <span class="topbar__project">@ProjectName</span>
            <span class="muted small mono">· @Environment</span>
        </div>
        <ModeBadge />
    </header>

    <nav class="shell__rail" aria-label="Sections">
        <div class="nav__section">Journey</div>
        <div class="nav__group nav__group--phases">
            @{ var activeIndex = Array.FindIndex(_navItems, x => x.Kind == ActiveKind); }
            @for (var i = 0; i < _navItems.Length; i++)
            {
                var item = _navItems[i];
                var state = activeIndex >= 0 && i < activeIndex ? "done" : item.Kind == ActiveKind ? "active" : null;
                <a class="nav__link @state"
                   href="@ModeRoot" @onclick="() => OnNavigate.InvokeAsync(item.Kind)" @onclick:preventDefault>
                    <span class="nav__num">@((i + 1).ToString("00"))</span>
                    <span>@item.Label</span>
                </a>
            }
        </div>

        <div class="nav__section">Scenario</div>
        <div class="nav__group">
            @foreach (var j in ForgeOps.Demo.JourneyCatalog.All)
            {
                <a class="nav__link nav__link--plain @(j.Key == CurrentJourneyKey ? "active" : null)" href="@($"{ModeRoot}/{j.Key}")">
                    <span>@j.Name<span class="nav__sub">@j.Blurb</span></span>
                </a>
            }
        </div>

        <div class="nav__section">Mode</div>
        <div class="nav__group">
            <a class="nav__link nav__link--plain @(ModeRoot == "demo" ? "active" : null)" href="demo">Demo &mdash; recorded</a>
            <a class="nav__link nav__link--plain @(ModeRoot == "live" ? "active" : null)" href="live">Live &mdash; real model</a>
        </div>
    </nav>

    <main class="shell__main">
        <div class="workspace">
            @ChildContent
        </div>
    </main>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string ProjectName { get; set; } = "CustomerHub";
    [Parameter] public string Environment { get; set; } = "demo";
    [Parameter] public JourneyStepKind? ActiveKind { get; set; }
    [Parameter] public EventCallback<JourneyStepKind> OnNavigate { get; set; }

    private string ModeRoot => Nav.Uri.Contains("/live", StringComparison.OrdinalIgnoreCase) ? "live" : "demo";

    private string CurrentJourneyKey
    {
        get
        {
            var seg = new Uri(Nav.Uri).Segments.LastOrDefault()?.Trim('/');
            return ForgeOps.Demo.JourneyCatalog.All.Any(j => j.Key == seg) ? seg! : ForgeOps.Demo.JourneyCatalog.DefaultKey;
        }
    }

    private readonly (JourneyStepKind Kind, string Label)[] _navItems =
    [
        (JourneyStepKind.Requirement, "Requirement"),
        (JourneyStepKind.Specification, "Specification"),
        (JourneyStepKind.Implementation, "Implementation"),
        (JourneyStepKind.Audit, "Audit"),
        (JourneyStepKind.QualityGates, "Quality gates"),
        (JourneyStepKind.AiReview, "AI review"),
        (JourneyStepKind.HumanDecision, "Decision"),
        (JourneyStepKind.AcceptanceRun, "Run & verify"),
        (JourneyStepKind.EngineeringHealth, "Health"),
    ];
}
