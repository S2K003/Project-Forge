@* Marginalia (ProjectForge.md §23.6, §15): the evidence for the current step, set
   as hanging annotations in the margin of the record — Finding → Evidence → Source →
   Decision. *@

<aside class="margin" aria-label="Evidence for this step">
    <div class="margin__head">Margin &mdash; evidence</div>
    @if (Nodes.Count == 0)
    {
        <div class="margin__empty">Evidence for this step is recorded here as it is produced.</div>
    }
    else
    {
        <div class="margin__list">
            @foreach (var n in Nodes)
            {
                <div class="margin__note @(n.IsDecision ? "is-decision" : null)">
                    <div class="margin__kicker">@n.Kicker</div>
                    <div class="margin__body @(n.Mono ? "mono" : null)">@n.Body</div>
                </div>
            }
        </div>
    }
</aside>

@code {
    public sealed record Node(string Kicker, string Body, bool Mono = false, bool IsDecision = false);

    [Parameter] public IReadOnlyList<Node> Nodes { get; set; } = [];
}
