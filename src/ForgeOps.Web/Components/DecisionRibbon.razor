@* AI proposes → a human signs off (ProjectForge.md §23.6, §2.1). Presented as an
   annotated record entry, never as a conversation. *@

<div class="decision">
    <div class="decision__part decision__part--ai">
        <div class="decision__kicker decision__kicker--ai">
            <span>&#9660;&nbsp; AI proposal</span>
            @if (Simulated)
            {
                <span class="chip is-ai">recorded</span>
            }
        </div>
        <div class="decision__body decision__body--ai">@AiContent</div>
    </div>

    <div class="decision__part decision__part--human">
        <div class="decision__kicker decision__kicker--human">Human decision</div>
        @if (Decision is not null)
        {
            <div class="decision__body">@(string.IsNullOrWhiteSpace(Decision.Reason) ? DecisionLabel(Decision.Kind) : Decision.Reason)</div>
            <div class="decision__sig">
                <strong>@Decision.DecidedBy</strong>
                &nbsp;&mdash;&nbsp;@DecisionLabel(Decision.Kind)
                &nbsp;&middot;&nbsp;@Decision.DecidedAt.ToString("dd MMM yyyy, HH:mm 'UTC'")
            </div>
        }
        else
        {
            <div class="decision__body decision__pending">Awaiting a human decision &mdash; @PendingHint</div>
        }
    </div>
</div>

@code {
    [Parameter] public RenderFragment? AiContent { get; set; }
    [Parameter] public HumanDecision? Decision { get; set; }
    [Parameter] public bool Simulated { get; set; }
    [Parameter] public string PendingHint { get; set; } = "nothing proceeds until an engineer decides.";

    private static string DecisionLabel(HumanDecisionKind kind) => kind switch
    {
        HumanDecisionKind.Accepted => "Accepted",
        HumanDecisionKind.Rejected => "Rejected",
        HumanDecisionKind.AcceptedWithModification => "Accepted with changes",
        _ => "Pending"
    };
}
