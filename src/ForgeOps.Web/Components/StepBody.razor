@* Renders the workspace content for one journey step. Same component in both modes. *@

@if (Step is null)
{
    return;
}

<div class="stack">
    <div>
        <h1 style="font-size:22px">@Step.Title</h1>
        <p class="muted mt-1">@Step.Caption</p>
    </div>

    @switch (Step.Kind)
    {
        case JourneyStepKind.SignIn:
            <div class="panel panel__pad" style="max-width:420px">
                <div class="field"><label>User</label><div class="input">demo.engineer@@forgeops.dev</div></div>
                <div class="field mt-2"><label>Workspace</label><div class="input">CustomerHub</div></div>
                <div class="small muted mt-2">@ModeSignInHint</div>
            </div>
            break;

        case JourneyStepKind.Requirement:
            <div class="panel panel--strong panel__pad">
                <div class="panel__title">Requirement</div>
                <p style="font-size:18px;line-height:1.5" class="mt-2">“@Definition?.RequirementText”</p>
            </div>
            break;

        case JourneyStepKind.Specification when Step.Payload.Specification is { } spec:
            <div class="panel panel--strong panel__pad">
                <div class="panel__title">@spec.Title</div>
                <p class="mt-2">@spec.Summary</p>

                <div class="panel__title mt-3">Acceptance criteria</div>
                <ul class="list-reset stack mt-2">
                    @foreach (var ac in spec.AcceptanceCriteria)
                    {
                        <li><strong class="is-info">@ac.Id</strong> &nbsp;@ac.Statement</li>
                    }
                </ul>

                @if (spec.OutOfScope.Count > 0)
                {
                    <div class="panel__title mt-3">Out of scope</div>
                    <ul class="stack mt-1">@foreach (var o in spec.OutOfScope) { <li class="muted">@o</li> }</ul>
                }
                @if (spec.OpenQuestions.Count > 0)
                {
                    <div class="panel__title mt-3">Open questions</div>
                    <ul class="stack mt-1">@foreach (var q in spec.OpenQuestions) { <li class="is-warn">@q</li> }</ul>
                }
            </div>
            <AiInteractionCard Interaction="Step.Payload.AiInteraction" />
            break;

        case JourneyStepKind.HumanReview:
            <DecisionRibbon Simulated="Sim(Step.Payload.AiInteraction)"
                            Decision="Step.Payload.AiInteraction?.Decision"
                            PendingHint="the specification cannot be approved by the model.">
                <AiContent>
                    Drafted a specification with @(Definition?.Steps.FirstOrDefault(s => s.Kind == JourneyStepKind.Specification)?.Payload.Specification?.AcceptanceCriteria.Count ?? 0)
                    testable acceptance criteria and 2 open questions.
                </AiContent>
            </DecisionRibbon>
            break;

        case JourneyStepKind.Implementation when Step.Payload.Implementation is { } impl:
            @if (impl.Origin == Contracts.Forge.ImplementationOrigin.ReferenceFallback)
            {
                <div class="panel panel__pad is-warn" role="alert">
                    <strong>⚠ The model's output did not compile within the repair budget.</strong>
                    <div class="small mt-1">ForgeOps substituted its reference implementation so the walkthrough can finish. The model's last attempt is shown below.</div>
                    <div class="mono small muted mt-1">@impl.RejectionDetail</div>
                </div>
            }
            <div class="panel panel--strong panel__pad">
                <div class="spread">
                    <span class="panel__title">Implementation</span>
                    <span class="chip @(impl.Origin == Contracts.Forge.ImplementationOrigin.ReferenceFallback ? "is-warn" : "is-pass")">
                        @OriginLabel(impl.Origin)
                    </span>
                </div>
                <p class="mt-2">@impl.Summary</p>
                @if (!string.IsNullOrWhiteSpace(impl.Rationale))
                {
                    <p class="small muted mt-1">@impl.Rationale</p>
                }
                <div class="row mt-2 small muted">
                    <span class="chip">@impl.Files.Count file(s)</span>
                    <span class="chip">@impl.RepairAttempts compile-repair round(s)</span>
                </div>
            </div>
            <div class="stack mt-3">
                @foreach (var file in impl.Files)
                {
                    <CodeBlock Path="@file.Path" Role="@(impl.Kind == Contracts.Forge.ImplementationKind.WebComponent ? "web component" : file.Role.ToString().ToLowerInvariant())" Content="@file.Content" />
                }
            </div>
            @if (impl.Kind == Contracts.Forge.ImplementationKind.WebComponent)
            {
                <div class="small muted mt-2">The component is rendered and checked at the <strong>Run &amp; verify</strong> step.</div>
            }
            @if (impl.Origin == Contracts.Forge.ImplementationOrigin.ReferenceFallback && impl.RejectedModelFiles.Count > 0)
            {
                <details class="panel panel__pad mt-3">
                    <summary class="muted small">Show the model's rejected attempt (@impl.RejectedModelFiles.Count file(s))</summary>
                    <div class="stack mt-2">
                        @foreach (var file in impl.RejectedModelFiles)
                        {
                            <CodeBlock Path="@file.Path" Role="rejected" Content="@file.Content" />
                        }
                    </div>
                </details>
            }
            <AiInteractionCard Interaction="Step.Payload.AiInteraction" />
            break;

        case JourneyStepKind.Audit when Step.Payload.Audit is { } audit:
            <AuditReportView Report="audit" />
            break;

        case JourneyStepKind.Audit:
            <div class="panel panel__pad muted">The deterministic audit runs here once code has been generated.</div>
            break;

        case JourneyStepKind.AcceptanceRun when Step.Payload.Ui is { DocumentHtml.Length: > 0 } ui:
            <div class="stack">
                <UiPreviewPanel Preview="ui" OnResults="OnUiResults" />
                <AcceptanceView Outcomes="Step.Payload.Acceptance ?? []" />
            </div>
            break;

        case JourneyStepKind.AcceptanceRun when Step.Payload.Ui is not null:
            <div class="panel panel__pad is-fail" role="alert">
                <strong>The generated component was blocked by the audit.</strong>
                <div class="small mt-1">See the deterministic audit step — it will not be rendered.</div>
            </div>
            break;

        case JourneyStepKind.AcceptanceRun:
            <div class="stack">
                <ScenarioView Run="Step.Payload.Scenario" />
                <AcceptanceView Outcomes="Step.Payload.Acceptance ?? []" />
                <TestRunView Title="ForgeOps canonical acceptance suite" Run="Step.Payload.CanonicalTestRun" />
                <TestRunView Title="Model's own tests" Run="Step.Payload.AiTestRun" />
            </div>
            break;

        case JourneyStepKind.QualityGates:
            <div class="panel panel--strong panel__pad">
                <GateTimeline Gates="Step.Payload.Gates ?? []" />
            </div>
            break;

        case JourneyStepKind.Merge:
            <div class="panel panel--strong panel__pad">
                <GateTimeline Gates="Step.Payload.Gates ?? []" />
            </div>
            @if (Step.Payload.PullRequest is { } merged)
            {
                <div class="panel panel__pad mt-3 is-pass">✓ PR #@merged.Number merged to main.</div>
            }
            break;

        case JourneyStepKind.AiReview:
            <div class="stack">
                @foreach (var f in Step.Payload.ReviewFindings ?? [])
                {
                    <div class="panel panel--focus panel__pad">
                        <div class="spread">
                            <SeverityBadge Severity="f.Severity" />
                            <span class="chip is-ai">@f.Classification</span>
                        </div>
                        <p class="mt-2"><strong>@f.Finding</strong></p>
                        <div class="mono muted mt-1">@f.Evidence</div>
                        <div class="mt-2"><span class="muted">Recommendation:</span> @f.Recommendation</div>
                        <div class="small muted mt-1">Model confidence @f.Confidence.ToString("P0") — self-reported, not a probability.</div>
                    </div>
                }
            </div>
            <AiInteractionCard Interaction="Step.Payload.AiInteraction" />
            break;

        case JourneyStepKind.HumanDecision:
            <DecisionRibbon Simulated="Sim(Step.Payload.AiInteraction)"
                            Decision="Step.Payload.AiInteraction?.Decision"
                            PendingHint="the model cannot approve running its own code.">
                <AiContent>
                    Reviewed the generated diff and verified the idempotency approach. The deterministic audit
                    is clean. Recommends proceeding to execution.
                </AiContent>
            </DecisionRibbon>
            break;

        case JourneyStepKind.Telemetry:
            <div class="panel panel--strong panel__pad">
                <table style="width:100%;border-collapse:collapse">
                    @foreach (var t in Step.Payload.Telemetry ?? [])
                    {
                        <tr style="border-bottom:1px solid var(--glass-border)">
                            <td class="mono small" style="padding:9px 0">@t.Metric</td>
                            <td style="padding:9px 0;text-align:right"><strong>@t.Value</strong></td>
                            <td class="muted small" style="padding:9px 0 9px 14px">@t.Detail</td>
                        </tr>
                    }
                </table>
            </div>
            break;

        case JourneyStepKind.EngineeringHealth when Step.Payload.Health is { } health:
            <div class="panel panel--focus panel__pad">
                <div class="row" style="align-items:flex-start;gap:28px">
                    <HealthOrb Score="health.Score" Components="health.Components" />
                    <div style="flex:1">
                        <div class="panel__title">Why?</div>
                        <ul class="list-reset stack mt-2">
                            @foreach (var r in health.Reasons)
                            {
                                <li class="@ReasonClass(r.Kind)">@ReasonGlyph(r.Kind) @r.Text</li>
                            }
                        </ul>
                        <div class="panel__title mt-3">Weighting</div>
                        <ul class="list-reset stack mt-2 small">
                            @foreach (var c in health.Components)
                            {
                                <li class="spread">
                                    <span class="muted">@c.Name (@c.Weight.ToString("P0"))</span>
                                    <span>@c.Score</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
            break;
    }

    @if (Step.Payload.Notes is { Count: > 0 } notes)
    {
        <div class="panel panel__pad">
            <div class="panel__title">Notes</div>
            <ul class="stack mt-2 small muted">@foreach (var n in notes) { <li>@n</li> }</ul>
        </div>
    }
</div>

@code {
    [Parameter] public JourneyStep? Step { get; set; }
    [Parameter] public JourneyDefinition? Definition { get; set; }
    [Parameter] public AppMode Mode { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<Contracts.Forge.UiCheckResult>> OnUiResults { get; set; }

    private string ModeSignInHint => Mode == AppMode.Demo
        ? "Demo Mode entry point — not real authentication."
        : "Live Mode: this is real authentication with role-based access in the full product.";

    private static bool Sim(AiInteractionRecord? r) => r?.Simulated ?? false;

    private static string OriginLabel(Contracts.Forge.ImplementationOrigin o) => o switch
    {
        Contracts.Forge.ImplementationOrigin.Model => "model — first try",
        Contracts.Forge.ImplementationOrigin.ModelWithRepairs => "model — after repair",
        _ => "reference fallback"
    };

    private static string ReasonClass(ReasonKind k) => k switch
    {
        ReasonKind.Pass => "is-pass",
        ReasonKind.Warn => "is-warn",
        _ => "is-fail"
    };

    private static string ReasonGlyph(ReasonKind k) => k switch
    {
        ReasonKind.Pass => "✓",
        ReasonKind.Warn => "⚠",
        _ => "✗"
    };
}
