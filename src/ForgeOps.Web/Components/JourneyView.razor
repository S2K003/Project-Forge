@implements IDisposable
@inject JourneyPlayer Player

<JourneyStepper Steps="Player.Steps" CurrentIndex="Player.CurrentIndex" OnSelect="Player.GoTo" />

@if (_error is not null)
{
    <div class="panel panel--focus panel__pad is-fail mt-2" role="alert">
        <strong>Live AI call failed.</strong> @_error
        <div class="small muted mt-1">Deterministic steps are unaffected. Retry, or switch to Demo Mode for the full recorded walkthrough.</div>
    </div>
}

<div class="workspace--split" style="display:grid; grid-template-columns: minmax(0, 1fr) 262px; gap: 52px; align-items: start;">
    <div>
        @if (Player.IsThinking)
        {
            <AiThinking Label="@(Player.ThinkingLabel ?? "Working…")" />
        }
        else
        {
            <div class="stepbody-enter" @key="Player.CurrentIndex">
                <StepBody Step="Player.Current" Definition="Player.Definition" Mode="Player.Mode"
                          RequirementText="Player.RequirementText" OnRequirementChanged="Player.SetRequirement"
                          OnUiResults="Player.SetUiResults"
                          RefineFeedback="Player.RefineFeedback" OnRefineFeedbackChanged="Player.SetRefineFeedback"
                          OnRefineAgain="RefineAgain" />
            </div>
        }

        <div class="row mt-4" style="gap:14px; padding-top:20px; border-top:1px solid var(--rule);">
            <button class="btn btn--ghost" @onclick="Back" disabled="@(Player.CurrentIndex == 0 || Player.IsThinking)">&larr;&nbsp; Back</button>

            @if (Player.IsLastStep)
            {
                <button class="btn" @onclick="Restart" disabled="@Player.IsThinking">Restart walkthrough</button>
            }
            else
            {
                <button class="btn btn--primary" @onclick="Next" disabled="@Player.IsThinking">
                    @NextLabel &nbsp;&rarr;
                </button>
            }

            <span class="muted mono small" style="margin-left:auto">@(Player.CurrentIndex + 1) / @Player.Steps.Count</span>
        </div>
    </div>

    <EvidenceRail Nodes="EvidenceNodes()" />
</div>

@code {
    [Parameter] public EventCallback<string> OnBridgeOffline { get; set; }

    private string? _error;

    protected override void OnInitialized() => Player.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task Next()
    {
        _error = null;
        var result = await Player.AdvanceAsync();
        switch (result.Kind)
        {
            case AdvanceResultKind.BridgeOffline:
                await OnBridgeOffline.InvokeAsync(result.Detail ?? "AI Bridge is offline.");
                break;
            case AdvanceResultKind.ModelError:
                _error = result.Detail;
                break;
        }
    }

    private async Task RefineAgain()
    {
        _error = null;
        var result = await Player.RefineAgainAsync();
        switch (result.Kind)
        {
            case AdvanceResultKind.BridgeOffline:
                await OnBridgeOffline.InvokeAsync(result.Detail ?? "AI Bridge is offline.");
                break;
            case AdvanceResultKind.ModelError:
                _error = result.Detail;
                break;
        }
    }

    private void Back() => Player.GoTo(Player.CurrentIndex - 1);

    private void Restart()
    {
        _error = null;
        Player.Reset();
    }

    private string NextLabel => Player.Steps.Count > Player.CurrentIndex + 1
        ? Player.Steps[Player.CurrentIndex + 1].Kind switch
        {
            JourneyStepKind.Specification => "Generate specification",
            JourneyStepKind.HumanReview => "Review & approve",
            JourneyStepKind.Implementation => "Generate implementation",
            JourneyStepKind.Audit => "Run deterministic audit",
            JourneyStepKind.QualityGates => "Show quality gates",
            JourneyStepKind.AiReview => "Run AI review",
            JourneyStepKind.HumanDecision => "Approve execution",
            JourneyStepKind.AcceptanceRun => "Run the code",
            JourneyStepKind.Refine => "Refine the code",
            JourneyStepKind.Merge => "Merge",
            JourneyStepKind.Telemetry => "Show telemetry",
            JourneyStepKind.EngineeringHealth => "Show engineering health",
            _ => "Continue"
        }
        : "Continue";

    private IReadOnlyList<EvidenceRail.Node> EvidenceNodes()
    {
        var step = Player.Current;
        if (step is null)
        {
            return [];
        }

        var nodes = new List<EvidenceRail.Node>();

        switch (step.Kind)
        {
            case JourneyStepKind.Specification when step.Payload.AiInteraction is { } ai:
                nodes.Add(new("Finding", $"{step.Payload.Specification?.AcceptanceCriteria.Count} acceptance criteria drafted"));
                nodes.Add(new("Source", $"{ai.Provider} · {ai.Model} · prompt {ai.PromptVersion}", Mono: true));
                nodes.Add(new("Validation", ai.Validation.Valid ? "Passed deterministic schema check (§9.2)" : string.Join("; ", ai.Validation.Errors)));
                break;

            case JourneyStepKind.Implementation when step.Payload.Implementation is { } impl:
                nodes.Add(new("Artifact", $"{impl.Files.Count} generated file(s)"));
                nodes.Add(new("Repair", $"{impl.RepairAttempts} compile-error round(s)"));
                if (step.Payload.AiInteraction is { } gi)
                {
                    nodes.Add(new("Source", $"{gi.Provider} · {gi.Model} · prompt {gi.PromptVersion}", Mono: true));
                }
                break;

            case JourneyStepKind.Audit when step.Payload.Audit is { } audit:
                nodes.Add(new("Verdict", audit.Verdict.ToString(), IsDecision: true));
                nodes.Add(new("Compile", audit.Compiled ? "Roslyn build succeeded" : "did not compile"));
                nodes.Add(new("Banned-API scan", $"{audit.BannedApis.Count} finding(s)"));
                foreach (var b in audit.BannedApis)
                {
                    nodes.Add(new("Evidence", $"{b.File}:{b.Line} {b.Api}", Mono: true));
                }
                break;

            case JourneyStepKind.QualityGates:
                foreach (var g in (step.Payload.Gates ?? []).Where(g => g.Status == GateStatus.Failed))
                {
                    nodes.Add(new("Blocking gate", g.Name));
                    foreach (var e in g.Errors)
                    {
                        nodes.Add(new("Evidence", e, Mono: true));
                    }
                }
                break;

            case JourneyStepKind.AcceptanceRun:
                foreach (var a in step.Payload.Acceptance ?? [])
                {
                    nodes.Add(new(a.CriterionId, $"{a.Status} — {a.Statement}",
                        IsDecision: a.Status == Contracts.Forge.AcceptanceStatus.Satisfied));
                    foreach (var t in a.EvidenceTests)
                    {
                        nodes.Add(new("Test", t, Mono: true));
                    }
                }
                break;

            case JourneyStepKind.AiReview:
                foreach (var f in step.Payload.ReviewFindings ?? [])
                {
                    nodes.Add(new($"{f.Severity} · {f.Classification}", f.Finding));
                    nodes.Add(new("Evidence", f.Evidence, Mono: true));
                }
                break;

            case JourneyStepKind.Refine when step.Payload.Refinement is { } round:
                nodes.Add(new("Round", $"{round.Round}", IsDecision: true));
                if (round.AddressedCriteria.Count > 0)
                {
                    nodes.Add(new("Addressed", string.Join(", ", round.AddressedCriteria)));
                }
                nodes.Add(new("Outcome", round.AllCriteriaMet ? "every criterion satisfied" : "criteria still open",
                    IsDecision: round.AllCriteriaMet));
                if (step.Payload.CanonicalTestRun is { } cr)
                {
                    nodes.Add(new("Canonical suite", $"{cr.Passed} / {cr.Passed + cr.Failed} passed", Mono: true));
                }
                break;

            case JourneyStepKind.HumanReview:
            case JourneyStepKind.HumanDecision:
                if (step.Payload.AiInteraction?.Decision is { } d)
                {
                    nodes.Add(new("Decision", $"{d.Kind} · {d.DecidedBy}", IsDecision: true));
                    if (!string.IsNullOrWhiteSpace(d.Reason))
                    {
                        nodes.Add(new("Reason", d.Reason!));
                    }
                }
                break;

            case JourneyStepKind.EngineeringHealth when step.Payload.Health is { } h:
                nodes.Add(new("Score", $"{h.Score} / 100 (deterministic)", IsDecision: true));
                foreach (var r in h.Reasons)
                {
                    nodes.Add(new(r.Kind.ToString(), r.Text));
                }
                break;
        }

        return nodes;
    }

    public void Dispose() => Player.Changed -= OnChanged;
}
