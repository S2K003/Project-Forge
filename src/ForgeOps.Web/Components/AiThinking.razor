<div class="drafting" role="status" aria-live="polite">
    <div class="drafting__label">
        <span>@Label</span>
        <span class="drafting__cursor" aria-hidden="true"></span>
    </div>
    <div class="drafting__lines" aria-hidden="true">
        <div class="drafting__line" style="width:78%"></div>
        <div class="drafting__line" style="width:92%"></div>
        <div class="drafting__line" style="width:64%"></div>
    </div>
    <div class="drafting__sub">@Sub</div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "Working…";
    [Parameter] public string Sub { get; set; } = "The interaction is identical in Live and Demo Mode — only the source of the answer differs.";
}
