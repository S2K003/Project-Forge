@page "/live"
@page "/live/{JourneyKey}"
@implements IAsyncDisposable
@inject AppModeService Mode
@inject JourneyPlayer Player
@inject AiBridgeMonitor Bridge

<PageTitle>ForgeOps · Live Mode</PageTitle>

<AppShell ProjectName="@(Player.Definition?.ProjectName ?? "CustomerHub")" Environment="live"
          OnNavigate="GoToKind" ActiveKind="Player.Current?.Kind">
    <JourneyView OnBridgeOffline="HandleBridgeOffline" />
</AppShell>

@if (Gated)
{
    <ConnectionGate Detail="@Bridge.LastStatus.Detail" Retrying="_retrying" OnRetry="Retry" />
}

@code {
    private bool _retrying;

    private bool Gated => Bridge.Connection == BridgeConnection.Disconnected;

    [Parameter] public string? JourneyKey { get; set; }

    protected override void OnInitialized()
    {
        Mode.Set(AppMode.Live);
        Bridge.Changed += OnChanged;
        Bridge.Start();
    }

    protected override void OnParametersSet()
    {
        var key = JourneyKey ?? JourneyCatalog.DefaultKey;
        if (Player.Definition is null || Player.Mode != AppMode.Live || Player.JourneyKey != key)
        {
            Player.Load(AppMode.Live, key);
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task Retry()
    {
        _retrying = true;
        try
        {
            await Bridge.CheckNowAsync();
        }
        finally
        {
            _retrying = false;
        }
    }

    private void HandleBridgeOffline(string detail) => Bridge.ForceDisconnected(detail);

    private void GoToKind(JourneyStepKind kind)
    {
        var index = Player.Steps.ToList().FindIndex(s => s.Kind == kind);
        if (index >= 0)
        {
            Player.GoTo(index);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Bridge.Changed -= OnChanged;
        await Bridge.StopAsync();
    }
}
