@page "/demo"
@page "/demo/{JourneyKey}"
@inject AppModeService Mode
@inject JourneyPlayer Player

<PageTitle>ForgeOps · Demo Mode</PageTitle>

<AppShell ProjectName="@(Player.Definition?.ProjectName ?? "CustomerHub")" Environment="demo"
          OnNavigate="GoToKind" ActiveKind="Player.Current?.Kind">
    <JourneyView />
</AppShell>

@code {
    [Parameter] public string? JourneyKey { get; set; }

    protected override void OnParametersSet()
    {
        Mode.Set(AppMode.Demo);
        var key = JourneyKey ?? JourneyCatalog.DefaultKey;
        if (Player.Definition is null || Player.Mode != AppMode.Demo || Player.JourneyKey != key)
        {
            Player.Load(AppMode.Demo, key);
        }
    }

    private void GoToKind(JourneyStepKind kind)
    {
        var index = Player.Steps.ToList().FindIndex(s => s.Kind == kind);
        if (index >= 0)
        {
            Player.GoTo(index);
        }
    }
}
