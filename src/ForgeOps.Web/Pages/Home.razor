@page "/"
@inject NavigationManager Nav
@inject ForgeOpsWebOptions Options
@inject AppModeService Mode
@inject AuthService Auth

<PageTitle>ForgeOps</PageTitle>

<div class="landing">
    <div class="landing__inner">
        <div class="eyebrow">
            <span class="brand__mark" style="--s:20px">F</span>
            <span>ForgeOps &mdash; Engineering Control Plane</span>
            <button class="signout" type="button" style="margin-left:auto" @onclick="SignOut">Sign out</button>
        </div>

        <h1 class="landing__title">A requirement becomes a<br />governed engineering <em>record</em>.</h1>
        <p class="landing__sub">
            Specification, generated code, deterministic audit, execution, refinement &mdash; each step
            written down with its evidence, and human judgment kept above every AI recommendation.
        </p>

        <div class="modecards">
            <div class="modecard" @onclick='() => Enter(AppMode.Demo)'>
                <div class="modecard__no">01</div>
                <h3 class="is-ai">Demo</h3>
                <p>
                    The full walkthrough replayed from a recorded record &mdash; a complex UI requirement
                    generated, audited, rendered in a sandboxed frame, then refined. No backend, no
                    network. Works anywhere, every time.
                </p>
                <span class="chip is-ai">Always available</span>
            </div>

            <div class="modecard @(Options.HasApi ? null : "is-disabled")"
                 @onclick="EnterLive" style="@(Options.HasApi ? null : "opacity:.5;cursor:not-allowed")">
                <div class="modecard__no">02</div>
                <h3 class="is-info">Live</h3>
                <p>
                    The real thing: the local coding model builds the artefact through the AI Bridge,
                    ForgeOps audits and renders it. A verified bridge connection is required &mdash;
                    losing it locks the app.
                </p>
                <span class="chip @(Options.HasApi ? "is-info" : "is-muted")">@(Options.HasApi ? "Requires AI Bridge" : "No API on this deploy")</span>
            </div>
        </div>

        <p class="small muted mt-4 mono">
            Three scenarios inside &mdash; two UI components, one backend rule. Same journey, same
            record, in both modes.
        </p>
    </div>
</div>

@code {
    private void Enter(AppMode mode)
    {
        Mode.Set(mode);
        Nav.NavigateTo(mode == AppMode.Demo ? "demo" : "live");
    }

    private void EnterLive()
    {
        if (Options.HasApi)
        {
            Enter(AppMode.Live);
        }
    }

    private async Task SignOut()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("login");
    }
}
