@page "/login"
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>ForgeOps · Sign in</PageTitle>

<div class="landing">
    <div class="landing__inner" style="max-width:460px;width:min(460px,92vw)">
        <div class="eyebrow">
            <span class="brand__mark" style="--s:20px">F</span>
            <span>ForgeOps &mdash; Engineering Control Plane</span>
        </div>

        <h1 class="landing__title" style="font-size:40px">Sign in to the <em>record</em>.</h1>
        <p class="landing__sub">Access is restricted. Enter your credentials to open the console.</p>

        <form class="panel panel__pad authform" @onsubmit="Submit" @onsubmit:preventDefault>
            <div class="field">
                <label for="auth-user">Username</label>
                <input id="auth-user" class="input" type="text" autocomplete="username" autofocus
                       spellcheck="false" autocapitalize="none"
                       @bind="_user" @bind:event="oninput"
                       aria-invalid="@(_error is not null)" />
            </div>

            <div class="field mt-3">
                <label for="auth-pass">Password</label>
                <input id="auth-pass" class="input" type="password" autocomplete="current-password"
                       @bind="_pass" @bind:event="oninput"
                       aria-invalid="@(_error is not null)"
                       aria-describedby="@(_error is not null ? "auth-error" : null)" />
            </div>

            @if (_error is not null)
            {
                <p id="auth-error" class="authform__error" role="alert">@_error</p>
            }

            <button class="btn btn--primary mt-3" type="submit" disabled="@_busy" style="width:100%;justify-content:center">
                @(_busy ? "Checking…" : "Enter")
            </button>
        </form>

        <p class="small muted mt-3 mono">
            The session marker is held in this tab only and clears when the tab closes.
        </p>
    </div>
</div>

@code {
    private string _user = string.Empty;
    private string _pass = string.Empty;
    private string? _error;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (Auth.Initialized && Auth.IsAuthenticated)
        {
            Nav.NavigateTo("");
        }
    }

    private async Task Submit()
    {
        if (_busy)
        {
            return;
        }

        _error = null;
        _busy = true;

        var ok = await Auth.TryLoginAsync(_user, _pass);

        _busy = false;
        if (ok)
        {
            Nav.NavigateTo("");
        }
        else
        {
            _pass = string.Empty;
            _error = "That username and password combination was not recognised.";
        }
    }
}
